  "narrative": {
    "northStar": "The Command Workbench",
    "overview": "Book Translator should feel like a precise local tool operated by one person, not a public SaaS dashboard and not a theatrical terminal simulation. Its visual language borrows the legibility, compactness, explicit state, and keyboard confidence of excellent command-line tools while preserving familiar web controls. The interface is dark, quiet, and information-forward. Hierarchy comes from topology, labels, borders, and typographic contrast rather than cards, illustration, or ornamental effects.",
    "keyCharacteristics": [
      "One visible pipeline with current state and technical detail always nearby.",
      "Sans-serif prose paired with monospace labels, metrics, identifiers, and logs.",
      "Flat tonal layers, crisp borders, compact spacing, and restrained cyan emphasis.",
      "Controls use direct verbs and expose keyboard shortcuts where they are real."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Cyan identifies interaction and current position; never scatter it as decoration.",
        "section": "colors"
      },
      {
        "name": "The Meaningful Mono Rule",
        "body": "Use monospace because content behaves like data, never merely to make the interface look technical.",
        "section": "typography"
      },
      {
        "name": "The Flat Instrument Rule",
        "body": "A region earns separation through function and tone, not decorative elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do show current state, progress, errors, and recovery actions without requiring exploratory clicks.",
      "Do use direct verbs, concise labels, and stable placement for repeated controls.",
      "Do make dense information scannable through alignment and consistent data columns."
    ],
    "donts": [
      "Don't imitate green-phosphor terminals, scanlines, CRT glow, or fake command prompts.",
      "Don't turn every section into a floating card or every status into a colorful badge.",
      "Don't add marketing copy, decorative book imagery, or motion that delays an operation."
    ]
  }
