{
  "name": "trucheman",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "vite build",
    "dev": "node --import tsx/esm src/server/index.ts --dev",
    "start": "node dist/server/src/server/index.js",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "audit:epub": "node --import tsx/esm src/server/evals/run-epub-consistency-audit.ts",
    "fix:agreement": "node --import tsx/esm src/server/evals/run-agreement-fix.ts",
    "report:models": "node --import tsx/esm src/server/evals/run-model-report.ts",
    "replay:consistency": "node --import tsx/esm src/server/evals/run-job-consistency.ts",
    "trace:segment": "node --import tsx/esm src/server/evals/run-segment-trace.ts",
    "eval:literary": "node --import tsx/esm src/server/evals/run-literary-editor-eval.ts",
    "eval:literary:ab": "npm run eval:literary -- --compare",
    "eval:literary:import": "node --import tsx/esm src/server/evals/run-literary-corpus-import.ts",
    "eval:literary:review": "node --import tsx/esm src/server/evals/run-literary-review-summary.ts",
    "eval:literary:review:build": "node --import tsx/esm src/server/evals/run-literary-review-build.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "busboy": "^1.6.0",
    "express": "^5.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "az": "^0.2.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  }
}
