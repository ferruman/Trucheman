TRUCHEMAN_DATA_DIR=./data
TRUCHEMAN_HOST=127.0.0.1
TRUCHEMAN_PORT=4173
# Port published on the host by Docker Compose. It remains bound to 127.0.0.1.
TRUCHEMAN_HTTP_PORT=4173
# One model for every stage works. For better final quality, use a faithful translation model, a
# stronger editing/repair model, and an independent critic model (ideally another model family).
TRUCHEMAN_TRANSLATION_API_KEY=
TRUCHEMAN_EDITING_API_KEY=
TRUCHEMAN_TRANSLATION_ENDPOINT=https://api.deepseek.com/chat/completions
TRUCHEMAN_TRANSLATION_MODEL=deepseek-v4-flash
TRUCHEMAN_EDITING_ENDPOINT=https://api.deepseek.com/chat/completions
TRUCHEMAN_EDITING_MODEL=deepseek-v4-flash
TRUCHEMAN_EDITING_PROMPT_VERSION=
TRUCHEMAN_CRITIC_API_KEY=
TRUCHEMAN_CRITIC_ENDPOINT=https://api.deepseek.com/chat/completions
TRUCHEMAN_CRITIC_MODEL=deepseek-v4-flash
TRUCHEMAN_CRITIC_THINKING=disabled
# Repair takes the editing endpoint, key and prompt version; only these two are its own.
TRUCHEMAN_REPAIR_MODEL=
TRUCHEMAN_REPAIR_THINKING=
TRUCHEMAN_CONSISTENCY_API_KEY=
TRUCHEMAN_CONSISTENCY_ENDPOINT=https://api.deepseek.com/chat/completions
TRUCHEMAN_CONSISTENCY_MODEL=deepseek-v4-flash
TRUCHEMAN_CONSISTENCY_THINKING=disabled
TRUCHEMAN_CONCURRENCY=4
TRUCHEMAN_TIMEOUT_MS=60000

# OpenAI Batch mode requires the official endpoint for every profile. Replace the endpoint and
# model values above (including critic and consistency) before choosing Batch in the UI:
# https://api.openai.com/v1/chat/completions
